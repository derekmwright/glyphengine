# Build output
/dist/
/.task/

# Binaries
*.exe
*.test
*.out

# Profiling
*.prof

# Logs
*.log

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# NOTE: shaders/*.spv are intentionally NOT ignored -- see .gitattributes.

# Blender leaves these behind running or importing anything under
# tools/blender/ (build_fixture.py imports export_level.py as a module) and
# on a real recipe run, an autosave backup of whatever .blend was open.
tools/blender/__pycache__/
*.blend1

# task determinism, task hud and task lights write captures here, and remove
# them on success. task lights leaves its pair behind when it fails, because
# what failed is a picture.
examples/.determinism/
examples/.hud/
examples/.sky/
examples/.lights/
examples/.waterlight/
examples/.waterblend/
examples/.nightlight/
examples/.skypalette/
examples/.shafts/
/.shadowcoverage/

# task clouds keeps its captures for visual review.
examples/.clouds/
