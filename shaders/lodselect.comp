#version 450
layout(local_size_x=64) in;
struct Instance { mat4 model; vec4 tint; };
layout(set=0,binding=0,std430) readonly buffer Placements { Instance placement[]; };
layout(set=0,binding=1,std430) writeonly buffer Buckets { Instance bucket[]; };
layout(set=0,binding=2,std430) buffer Commands { uint command[]; };
layout(set=0,binding=4,std430) buffer Scratch { uint data[]; };
shared uint scan[64*9];
layout(set=0,binding=3,std140) uniform Levels { vec4 distances[2]; uvec4 vertices[2]; uvec4 firstIndex[2]; uvec4 vertexOffset[2]; };
layout(push_constant) uniform Selection {
    vec4 planes[6]; vec4 eyeRadius;
    float fadeWidth; uint levels; uint bands; uint count;
    uint capacity; uint reset; uint dropped;
} pc;

void select(Instance p, out uvec2 bands, out vec2 fades, out uint culled) {
    bands=uvec2(255); fades=vec2(0); culled=0;
    precise float a=p.model[0].x*p.model[0].x+p.model[0].y*p.model[0].y+p.model[0].z*p.model[0].z;
    precise float b=p.model[1].x*p.model[1].x+p.model[1].y*p.model[1].y+p.model[1].z*p.model[1].z;
    precise float c=p.model[2].x*p.model[2].x+p.model[2].y*p.model[2].y+p.model[2].z*p.model[2].z;
    precise float radius=pc.eyeRadius.w*sqrt(max(a,max(b,c)));
    vec3 pos=p.model[3].xyz;
    if (pc.eyeRadius.w>0) for (uint j=0;j<6;j++) {
        precise float d=pc.planes[j].x*pos.x+pc.planes[j].y*pos.y+pc.planes[j].z*pos.z+pc.planes[j].w;
        if (d < -radius) { culled=1; return; }
    }
    precise vec3 delta=pos-pc.eyeRadius.xyz;
    precise float d=sqrt(delta.x*delta.x+delta.y*delta.y+delta.z*delta.z);
    uint level=0;
    while (level<pc.levels && d>=distances[level/4][level%4]) level++;
    int boundary=-1;
    if (pc.fadeWidth>0) {
        if (level<pc.levels && d>=distances[level/4][level%4]-pc.fadeWidth/2) boundary=int(level);
        else if (level>0 && d<distances[(level-1)/4][(level-1)%4]+pc.fadeWidth/2) boundary=int(level)-1;
    }
    if (boundary>=0) {
        precise float t=(d-(distances[boundary/4][boundary%4]-pc.fadeWidth/2))/pc.fadeWidth;
        bands=uvec2(boundary,boundary+1); fades=vec2(1-t,t);
    } else if (level<pc.bands) { bands.x=level; fades.x=1; }
    else culled=1;
    for (uint k=0;k<2;k++) if (bands[k]>=pc.bands || fades[k]<=0) bands[k]=255;
}

// Classify and scan each 64-placement block, scan the block totals, then
// scatter by placement index. No atomic append order reaches a vertex buffer.
// 25-lod-forest frame 61, 1280x720 MSAA4, fixed 16.667ms: atomic append
// differed from CPU in 4 channels (max 5/255), and between repeats in 1
// channel (max 1/255). Ordered scatter: zero differing channels in both.
void main() {
    uint i=gl_GlobalInvocationID.x, lane=gl_LocalInvocationID.x;
    uint groups=(pc.count+63)/64;
    uint totals=pc.capacity*6;
    if (pc.reset==1) {
        if (i>pc.bands) return;
        uint sum=0;
        for (uint g=0;g<groups;g++) {
            uint at=totals+g*9+i, n=data[at]; data[at]=sum; sum+=n;
        }
        if (i==pc.bands) command[i*5]=sum+pc.dropped;
        else {
            command[i*5]=vertices[i/4][i%4]; command[i*5+1]=sum;
            command[i*5+2]=firstIndex[i/4][i%4]; command[i*5+3]=vertexOffset[i/4][i%4]; command[i*5+4]=0;
        }
        return;
    }
    if (pc.reset==2) {
        if (i>=pc.count) return;
        for (uint k=0;k<2;k++) {
            uint band=data[i*6+k];
            if (band>=pc.bands) continue;
            uint at=data[totals+(i/64)*9+band]+data[i*6+4+k];
            Instance p=placement[i]; p.tint.w=uintBitsToFloat(data[i*6+2+k]);
            bucket[band*pc.capacity+at]=p;
        }
        return;
    }
    uvec2 bands=uvec2(255); vec2 fades=vec2(0); uint culled=0;
    if (i<pc.count) select(placement[i],bands,fades,culled);
    for (uint b=0;b<=pc.bands;b++) scan[lane*9+b]=b==pc.bands?culled:uint(bands.x==b || bands.y==b);
    barrier();
    for (uint stride=1;stride<64;stride*=2) {
        uint values[9];
        for (uint b=0;b<=pc.bands;b++) values[b]=scan[lane*9+b]+(lane>=stride?scan[(lane-stride)*9+b]:0);
        barrier();
        for (uint b=0;b<=pc.bands;b++) scan[lane*9+b]=values[b];
        barrier();
    }
    if (lane==63) for (uint b=0;b<=pc.bands;b++) data[totals+gl_WorkGroupID.x*9+b]=scan[lane*9+b];
    if (i<pc.count) for (uint k=0;k<2;k++) {
        data[i*6+k]=bands[k]; data[i*6+2+k]=floatBitsToUint(fades[k]);
        data[i*6+4+k]=bands[k]<pc.bands?scan[lane*9+bands[k]]-1:0;
    }
}
